def update_model_prices(model, P_e_t_new, P_c_t_new):
    for e in model.E:
        for t in model.T:
            if (e, t) in P_e_t_new:
                model.P_e_t[e, t] = P_e_t_new[(e, t)]
    
    for c in model.C:
        for t in model.T:
            if (c, t) in P_c_t_new:
                model.P_c_t[c, t] = P_c_t_new[(c, t)]



def update_model_inflow(model, I_t_new):
    
    for t in model.T:
        if t in I_t_new:
            model.I_t[t] = float(I_t_new[t])


def update_model_state(model, S_start_new, y_c_fixed_new=None):
    model.S_start = S_start_new



def add_cuts_to_model(model, new_cuts):
    
    # Unfix theta when adding the first cut (it was fixed to 0 to prevent unboundedness)
    if model.theta.is_fixed():
        model.theta.unfix()

    for cut in new_cuts:
        expr = cut['intercept'] + cut['slope_v'] * (model.s_end - cut['state_v'])
        model.cut_constraints.add(model.theta <= expr)


def generate_benders_cut(Q_values, lambda_v_values, v_state, probabilities=None):
   

    Q_avg = sum(Q * p for Q, p in zip(Q_values, probabilities))
    lambda_v_avg = sum(lv * p for lv, p in zip(lambda_v_values, probabilities))
    
    cut = {
        'intercept': Q_avg,
        'slope_v': lambda_v_avg,
        'state_v': v_state,
    }
    
    return cut


def sddp_algorithm_adaptive(
    stages,
    max_iterations=50,
    num_scenarios=3,
    convergence_tol=None,
    forward_seed=None,
    sample_forward_scenarios=True,
    num_forward_paths=1,
):
   
    num_stages = len(stages)

    # Pre-assign a reserve price level to each stage with equal probability (1/3).
    _reserve_rng = np.random.default_rng(forward_seed)
    reserve_level_per_stage = {
        n: RESERVE_PRICE_LEVELS[int(_reserve_rng.integers(RESERVE_PRICE_N))]
        for n in range(num_stages)
    }
    _lv_counts = {lv: sum(1 for l in reserve_level_per_stage.values() if l == lv) for lv in RESERVE_PRICE_LEVELS}
    print(f"Pre-assigned reserve price levels (low={_lv_counts['low']}, mid={_lv_counts['mid']}, high={_lv_counts['high']})")

    rng = np.random.default_rng(forward_seed)

    K_stages = {n: [] for n in range(num_stages - 1)}

    

    # Storage for results
    iteration_results = []
    
    print("\n" + "="*80)
    print(f"Adaptive SDDP Algorithm - {num_stages} Stages (OPTIMIZED)")
    print(f"Max iterations: {max_iterations}, Scenarios: {num_scenarios}")
    print("="*80 + "\n")
    
    
    print("Pre-building stage models...")
    stage_models = {}
    solver = SolverFactory('gurobi')
    solver.options['DualReductions'] = 0
    
    for n in range(num_stages):
        stage_hours = stages[n]
        is_last = (n == num_stages - 1)

        _stage_level = reserve_level_per_stage[n]  # Pre-assigned reserve level for this stage
        for r in range(3):
            stage_models[(n, r)] = create_stage_model(
                stage_hours=stage_hours,
                E=E, C=C, C_d=C_d, C_u=C_u,
                P_e_t=P_e_t,  # Base energy prices (overwritten per regime before each solve)
                P_c_t=P_c_t[r][_stage_level],  # Reserve prices for pre-assigned level
                I_t=I_t,
                C_max=C_max, C_min=C_min,
                S_max=S_max, S_min=S_min,
                eta_plant=eta_plant,
                V_c_t_max=V_c_t_max,
                V_e_t_max=V_e_t_max,
                S_start=S_0,
                A_e=A_e,
                cuts=[],
                is_last_stage=is_last,
                S_end_target=S_0 if is_last else None,
                S_end_min=None,
                allow_end_slack=is_last,
            )

    print(f"Built {num_stages * 3} stage models (3 regimes per stage, as reserve level is pre-assigned)")
    
    for iteration in range(max_iterations):
        print(f"\n{'='*60}")
        print(f"Iteration {iteration + 1}/{max_iterations}")
        print(f"{'='*60}")
        
        print("\n--- Forward Pass ---")

        
        forward_paths = []

        for path_idx in range(int(num_forward_paths)):
            print(f"\n  Forward path {path_idx+1}/{int(num_forward_paths)}")
            forward_path = {}  # Store results for each stage in this path
            current_reservoir = S_0

            current_regime = int(rng.choice(3, p=MARKOV_PI0)) if sample_forward_scenarios else 1

            for n in range(num_stages):
                print(f"\n  Stage {n+1}/{num_stages}")
                stage_hours = stages[n]

                regime = int(current_regime)
                # Reserve price level is pre-assigned per stage (resolved by pre-processing).
                reserve_level = reserve_level_per_stage[n]
                # Stage parameters: spot+inflow from Thema regime, reserve prices from pre-assigned level.
                from block_scenarios import build_stage_joint_scenarios_from_blocks

                scen_list = build_stage_joint_scenarios_from_blocks(
                    stage_index=int(n),
                    stage_hours=list(stage_hours),
                    base_P_e_t=P_e_t,
                    base_P_c_t=P_c_t[regime][reserve_level],
                    base_I_t=I_t,
                    data=BLOCK_DATA,
                    da_market="DA",
                    energy_markets=list(E),
                    capacity_markets=list(C),
                )
                match = [x for x in scen_list if int(x[4]) == int(regime)]
                P_e_t_stage, P_c_t_stage, I_t_stage, scen_prob, _ = match[0] if match else scen_list[0]

                
                _fcrn_reserve_scen = _regime_week_dicts["FCR-N"][regime][n]
                _afrr_reserve_scen = _regime_week_dicts["aFRR"][regime][n]
                _fcrd_reserve_scen = _regime_week_dicts["FCR-D"][regime][n]
                print(f"    Uke {n+1:>2} | Regime: {regime} | rep_year: {_rep_year} | "
                      f"Reserve level: {reserve_level} | "
                      f"Reserve scen → FCR-N: {_fcrn_reserve_scen}, FCR-D: {_fcrd_reserve_scen}, aFRR: {_afrr_reserve_scen}")

                # SELECT the pre-built model for this regime (reserve level already baked in).
                model_stage = stage_models[(n, int(regime))]
                is_last = (n == num_stages - 1)

                # Update energy prices
                update_model_prices(model_stage, P_e_t_stage, P_c_t_stage)

                # Update inflow
                update_model_inflow(model_stage, I_t_stage)

                # Update state
                update_model_state(model_stage, current_reservoir, None)

                # Solve model
                results = solver.solve(model_stage, tee=False)        
                end_reservoir = pyo.value(model_stage.s_end)
                obj_stage = pyo.value(model_stage.OBJ)
                theta_value = pyo.value(model_stage.theta)

                
                stage_energy_rev = {e: 0.0 for e in E}
                stage_capacity_rev = {c: 0.0 for c in C}
                for t in stage_hours:
                    for e in E:
                        x_val = float(pyo.value(model_stage.x_e_t[e, t]))
                        price = float(pyo.value(model_stage.P_e_t[e, t]))
                        if e == "ID Buy":
                            stage_energy_rev[e] -= price * x_val
                        else:
                            stage_energy_rev[e] += price * x_val
                    for c in C:
                        y_val = float(pyo.value(model_stage.y_c_t[c, t]))
                        stage_capacity_rev[c] += float(pyo.value(model_stage.P_c_t[c, t])) * y_val

                true_revenue = float(sum(stage_energy_rev.values()) + sum(stage_capacity_rev.values()))

                penalty_cost = 0.0
                emergency_water = 0.0
                if hasattr(model_stage, 'ex_water_inflow'):
                    emergency_water = float(pyo.value(model_stage.ex_water_inflow))
                    if emergency_water > 0.001:
                        print(f"    Emergency water used: {emergency_water:.4f} GWh in Stage {n+1}")
                        print(f"      Start reservoir was: {current_reservoir:.2f} GWh")
                    if emergency_water > 0.0:
                        penalty_cost += float(EMERGENCY_WATER_PENALTY_EUR_PER_GWH) * float(emergency_water)

                total_penalty = penalty_cost

                print(f"    Start reservoir: {current_reservoir:.2f} GWh")
                print(f"    End reservoir: {end_reservoir:.2f} GWh")
                print(f"    Stage revenue (without penalty/future): {true_revenue:.2f} EUR")
                print(f"    Objective (with penalty + future): {obj_stage:.2f} EUR")
                print(f"    Theta (future value): {theta_value:.2f} EUR")
                if total_penalty > 0.01:
                    print(f"    Penalty cost: {total_penalty:.2f} EUR")

                forward_path[n] = {
                    'start_reservoir': current_reservoir,
                    'end_reservoir': end_reservoir,
                    'objective': obj_stage,
                    'theta': theta_value,
                    'revenue': true_revenue,
                    'penalty': total_penalty,
                    'stage_hours': stage_hours,
                    'prices_e': P_e_t_stage,
                    'prices_c': P_c_t_stage,
                    'inflow': I_t_stage,
                    'regime': int(regime),
                    'reserve_level': reserve_level,
                }

                current_reservoir = end_reservoir

                if n < num_stages - 1:
                    if sample_forward_scenarios:
                        Pn = MARKOV_P_BY_STAGE[int(n)]
                        current_regime = int(rng.choice(3, p=Pn[int(regime), :]))
                    else:
                        current_regime = int(regime)

            forward_paths.append(forward_path)
        
        
        # BACKWARD PASS 
        print("\n--- Backward Pass ---")
        for n in range(num_stages - 2, -1, -1):
            visited_states = set()
            for fp in forward_paths:
                visited_states.add(round(float(fp[n]['end_reservoir']), 6))
            uniq_states = list(visited_states)
            next_stage_hours = stages[n + 1]
            print(f"  Backward stage {n+1}/{num_stages-1}, {len(uniq_states)} state(s)...")
            for v_n in uniq_states:
                Q_exp = 0.0
                lambda_exp = 0.0
                delkutt = []
                regime_kutt = []

        
                _next_level = reserve_level_per_stage[n + 1]
                from block_scenarios import build_stage_joint_scenarios_from_blocks
                scen_map = {
                    _r: build_stage_joint_scenarios_from_blocks(
                        stage_index=int(n + 1),
                        stage_hours=list(next_stage_hours),
                        base_P_e_t=P_e_t,
                        base_P_c_t=P_c_t[_r][_next_level],
                        base_I_t=I_t,
                        data=BLOCK_DATA,
                        da_market="DA",
                        energy_markets=list(E),
                        capacity_markets=list(C),
                    )
                    for _r in range(3)
                }

                print(f"    {'r_curr':>6} {'r_next':>6} {'p(Markov)':>10} {'Q':>12} {'λ':>10} {'vekt':>8}")
                print(f"    {'-'*56}")
                for r_curr in range(3):
                    mu_r = MU[n][r_curr] if 'MU' in globals() else 1.0/3.0
                    probs = MARKOV_P_BY_STAGE[int(n)][int(r_curr), :]
                    Q_r = 0.0
                    lambda_r = 0.0
                    for r_next in range(3):
                        markov_prob = float(probs[r_next])
                        joint_prob = markov_prob
                        scen_list = scen_map[r_next]
                        match = [x for x in scen_list if int(x[4]) == int(r_next)]
                        P_e_t_next, P_c_t_next, I_t_next, _, _ = match[0] if match else scen_list[0]
                        model_next = stage_models[(n + 1, int(r_next))]
                        update_model_prices(model_next, P_e_t_next, P_c_t_next)
                        update_model_inflow(model_next, I_t_next)
                        update_model_state(model_next, v_n, None)
                        results_next = solver.solve(model_next, tee=False)
                        
                        Q = float(pyo.value(model_next.OBJ))
                        lambda_v = float(model_next.dual[model_next.Start_Reservoir_Level_Def])
                        vekt = mu_r * joint_prob
                        print(f"    {r_curr:>6} {r_next:>6} {markov_prob:>10.3f} {Q:>12.2f} {lambda_v:>10.4f} {vekt:>8.5f}")
                        delkutt.append((r_curr, r_next, _next_level, vekt, Q, lambda_v))
                        Q_r += joint_prob * Q
                        lambda_r += joint_prob * lambda_v
                        Q_exp += vekt * Q
                        lambda_exp += vekt * lambda_v
                    print(f"    {'':>6} {'sum':>6} {'':>10} μ={mu_r:.3f}  E[Q]={mu_r*Q_r:10.2f}  E[λ]={mu_r*lambda_r:8.4f}")
                    regime_kutt.append((r_curr, mu_r*Q_r, mu_r*lambda_r))
                print(f"    {'-'*56}")
                cut = {'intercept': Q_exp, 'slope_v': lambda_exp, 'state_v': v_n}
                print(f"  CUT:  Stage {n+1:>2} | v={v_n:.4f} GWh | θ ≤ {Q_exp:.2f} + {lambda_exp:.4f}·(s_end − {v_n:.4f})")
                K_stages[n].append(cut)

                # Append to all regimes:
                for r in range(3):
                    add_cuts_to_model(stage_models[(n, r)], [cut])
        
    
        # Store results 
        path_revenues = [sum(fp[n]['revenue'] for n in range(num_stages)) for fp in forward_paths]
        path_penalties = [sum(fp[n]['penalty'] for n in range(num_stages)) for fp in forward_paths]
        total_revenue = float(np.mean(path_revenues))
        total_penalty = float(np.mean(path_penalties))
        
        # Calculate aggregate statistics
        total_capacity_sales = {c: 0.0 for c in C}
        total_energy_sales = {e: 0.0 for e in E}
        total_production_mwh = 0.0
        total_spill = 0.0
        reservoir_levels = []
        
        # Detailed production/sales accounting: use the first forward path as a representative trajectory.
        forward_path = forward_paths[0]

        for n in range(num_stages):
            stage_hours = forward_path[n]['stage_hours']
            model_stage = stage_models[(n, int(forward_path[n]['regime']))]

            
            # Capacity sales (current stage)
            for c in C:
                for t in stage_hours:
                    total_capacity_sales[c] += pyo.value(model_stage.y_c_t[c, t])
            
            # Energy sales/purchases
            for e in E:
                for t in stage_hours:
                    total_energy_sales[e] += pyo.value(model_stage.x_e_t[e, t])
            
            # Production
            for t in stage_hours:
                prod = sum(pyo.value(model_stage.x_e_t[e, t]) for e in E if e != "ID Buy") - pyo.value(model_stage.x_e_t["ID Buy", t])
                total_production_mwh += prod
            
            # Reservoir levels
            reservoir_levels.append(forward_path[n]['start_reservoir'])
            if n == num_stages - 1:
                reservoir_levels.append(forward_path[n]['end_reservoir'])
            
            
        
        avg_reservoir = sum(reservoir_levels) / len(reservoir_levels)
        
        iteration_results.append({
            'iteration': iteration + 1,
            'revenue': total_revenue,
            'penalty': total_penalty,
            'actual_value': total_revenue - total_penalty,
            'stage_results': forward_path,
            'capacity_sales': total_capacity_sales.copy(),
            'energy_sales': total_energy_sales.copy(),
            'total_production': total_production_mwh,
            'avg_reservoir': avg_reservoir,
            'total_spill': total_spill
        })
        
        print(f"\n{'='*60}")
        print(f"Iteration {iteration + 1} Complete")
        print(f"{'='*60}")
        print(f"Total Revenue (actual income): {total_revenue:.2f} EUR")
        if total_penalty > 0.01:
            print(f"Total penalty cost: {total_penalty:.2f} EUR")
        print(f"\nProduction & Sales:")
        print(f"  Total production: {total_production_mwh:.2f} MWh ({total_production_mwh/1000:.2f} GWh)")
        print(f"  Energy sales:")
        for e in E:
            if e != "ID Buy":
                print(f"    {e}: {total_energy_sales[e]:.2f} MWh")
            else:
                print(f"    {e} (purchase): {total_energy_sales[e]:.2f} MWh")
        print(f"  Capacity sales (total MW⋅h):")
        for c in C:
            print(f"    {c}: {total_capacity_sales[c]:.2f} MW⋅h")
        print(f"\nReservoir & Water:")
        print(f"  Average reservoir level: {avg_reservoir:.2f} GWh")
        print(f"  Start: {reservoir_levels[0]:.2f} GWh, End: {reservoir_levels[-1]:.2f} GWh")
    
        print(f"\nAlgorithm Progress:")
        print(f"  Total cuts: {sum(len(K_stages[n]) for n in range(num_stages - 1))}")
        print(f"{'='*60}")
        

        valid_LB_samples = []   
        valid_flags = [pen <= 1.0 for pen in path_penalties]
        for lb, ok in zip(path_LBs, valid_flags):
            if ok:
                valid_LB_samples.append(float(lb))

    print("SDDP Algorithm Complete")

    
    return {
        'iterations': iteration_results,
        'cuts': K_stages,
        'num_stages': num_stages,
        'lower_bound_samples': valid_LB_samples,
        'lb_mean_history': lb_mean_history,
    }


