def create_coeff(x_points, y_points):
    """
    Create piecewise linear coefficients (slopes and intercepts) for turbine-generator efficiency.
    """
    m_list = []
    b_list = []
    for i in range(len(x_points) - 1):
        x1, x2 = x_points[i], x_points[i + 1]
        y1, y2 = y_points[i], y_points[i + 1]
        m = (y2 - y1) / (x2 - x1)
        b = y1
        m_list.append(m)
        b_list.append(b)
    return np.array(m_list), np.array(b_list)





