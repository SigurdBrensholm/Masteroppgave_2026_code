            "Net_energy_sold_MWh": "sum",
            "P_hyd_MWh_per_h": "sum",
            "aFRR_up_MW": "mean",
            "aFRR_down_MW": "mean",
            "FCR_N_MW": "mean",
            "FCR_D_MW": "mean",
            "Rev_DA_EUR": "sum",
            "Rev_ID_EUR": "sum",
            "Rev_aFRR_up_EUR": "sum",
            "Rev_aFRR_down_EUR": "sum",
            "Rev_FCR_N_EUR": "sum",
            "Rev_FCR_D_EUR": "sum",
            "Rev_total_EUR": "sum",
            "Spot_price": "mean",
            "Inflow_GWh": "sum",
        }).reset_index()
        
        if 'Reserve_Level' in combined_df.columns:
            reserve_info = combined_df.groupby(["Year", "Week"]).agg({
                "Reserve_Level": "first",
                "Reserve_Scenario": "first",
            }).reset_index()
            weekly_summary = weekly_summary.merge(reserve_info, on=["Year", "Week"], how="left")
        
        weekly_file = output_dir / f"simulation_weekly_{scenario_name}{seed_suffix}_{timestamp}.csv"
        weekly_summary.to_csv(weekly_file, index=False, sep=";", decimal=",")
        print(f" Weekly summary saved to: {weekly_file}")
        
        # Yearly summary
        yearly_summary = combined_df.groupby("Year").agg({
            "Rev_DA_EUR": "sum",
            "Rev_ID_EUR": "sum",
            "Rev_aFRR_up_EUR": "sum",
            "Rev_aFRR_down_EUR": "sum",
            "Rev_FCR_N_EUR": "sum",
            "Rev_FCR_D_EUR": "sum",
            "Rev_total_EUR": "sum",
            "DA_prod_MWh": "sum",
            "ID_sell_MWh": "sum",
            "ID_buy_MWh": "sum",
            "Net_energy_sold_MWh": "sum",
            "P_hyd_MWh_per_h": "sum",
            "Spot_price": "mean",
            "Inflow_GWh": "sum",
        }).reset_index()
        yearly_summary["Rev_total_MEUR"] = yearly_summary["Rev_total_EUR"] / 1e6
        yearly_summary["Total_prod_GWh"] = yearly_summary["DA_prod_MWh"] / 1e3
        yearly_summary["P_hyd_GWh"] = yearly_summary["P_hyd_MWh_per_h"] / 1e3
        
        yearly_file = output_dir / f"simulation_yearly_{scenario_name}{seed_suffix}_{timestamp}.csv"
        yearly_summary.to_csv(yearly_file, index=False, sep=";", decimal=",")
        print(f" Yearly summary saved to: {yearly_file}")
        
        print(f"Simulation complete: {len(all_results)} years")
        for _, row in yearly_summary.iterrows():
            print(f"  {int(row['Year'])}: {row['Rev_total_MEUR']:.1f} MEUR, {row['Total_prod_GWh']:.1f} GWh")
        
        # SDDP reserve level verification
        if 'Reserve_Level' in combined_df.columns:
            actual_levels = combined_df.groupby(['Week', 'Reserve_Level']).size().reset_index(name='hours')
            unique_weeks = actual_levels['Week'].nunique()
            print(f"\n Verified: {unique_weeks} weeks using SDDP reserve assignments")
        
    
    return combined_df if all_results else None
        
