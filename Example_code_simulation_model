def create_coeff(x_points, y_points):
    """
    Create piecewise linear coefficients (slopes and intercepts) for turbine-generator efficiency.
    """
    m_list = []
    b_list = []
    for i in range(len(x_points) - 1):
        x1, x2 = x_points[i], x_points[i + 1]
        y1, y2 = y_points[i], y_points[i + 1]
        m = (y2 - y1) / (x2 - x1)
        b = y1
        m_list.append(m)
        b_list.append(b)
    return np.array(m_list), np.array(b_list)


def create_stage_model(stage_hours, E, C, C_d, C_u, P_e_t, P_c_t, I_t,
                       C_max, C_min, S_max, S_min, eta_plant,
                       V_c_t_max, V_e_t_max, S_start, A_e, cuts,
                       y_c_fixed=None, next_stage_hours=None,
                       is_last_stage=False, S_end_target=None, S_end_min=None,
                       delta_up=0.0175, delta_down=0.0095, allow_end_slack=False):
    """Create optimization model for one stage (period) - matches SDDP model signature exactly."""
    model = pyo.ConcreteModel()
    
    ### Sets ###
    model.T = pyo.Set(initialize=stage_hours, ordered=True)
    model.E = pyo.Set(initialize=E)
    model.C = pyo.Set(initialize=C)
    model.C_d = pyo.Set(initialize=C_d)
    model.C_u = pyo.Set(initialize=C_u)
    
    ### Parameters ###
    model.P_e_t = pyo.Param(model.E, model.T, initialize=lambda model, e, t: P_e_t.get((e, t), 0), mutable=True)
    model.P_c_t = pyo.Param(model.C, model.T, initialize=lambda model, c, t: P_c_t.get((c, t), 0), mutable=True)
    model.I_t = pyo.Param(model.T, initialize=lambda model, t: I_t.get(t, 0), mutable=True)
    model.C_max = pyo.Param(initialize=C_max)
    model.C_min = pyo.Param(initialize=C_min)
    model.S_max = pyo.Param(initialize=S_max)
    model.S_min = pyo.Param(initialize=S_min)
    model.eta_plant = pyo.Param(initialize=eta_plant)
    model.V_c_t_max = pyo.Param(model.C, model.T, initialize=lambda model, c, t: V_c_t_max.get((c, t), 0))
    model.V_e_t_max = pyo.Param(model.E, model.T, initialize=lambda model, e, t: V_e_t_max.get((e, t), 0))
    model.S_start = pyo.Param(initialize=S_start, mutable=True)
    model.A_e = pyo.Param(model.E - {"DA"}, initialize=A_e, mutable=True)
    model.delta_up = pyo.Param(initialize=delta_up)
    model.delta_down = pyo.Param(initialize=delta_down)
    
    ### Decision variables ###
    model.x_e_t = pyo.Var(model.E, model.T, domain=pyo.NonNegativeReals)
    model.y_c_t = pyo.Var(model.C, model.T, domain=pyo.NonNegativeReals)
    model.s_t = pyo.Var(model.T, within=pyo.NonNegativeReals)
    model.P_hyd = pyo.Var(model.T, within=pyo.NonNegativeReals)
    model.P_shaft = pyo.Var(model.T, within=pyo.NonNegativeReals)
    model.s_end = pyo.Var(within=pyo.NonNegativeReals)
    model.s_start_week = pyo.Var(within=pyo.NonNegativeReals)
    
    # Future value approximation (theta variable for cuts)
    model.theta = pyo.Var(within=pyo.Reals)
    # Fix theta only in the terminal stage.
    if is_last_stage:
        model.theta.fix(0)
    
    
    ### Objective Function ###
    def objective_function(model):
        immediate_value = (
            sum(model.P_e_t[e, t] * model.x_e_t[e, t] for e in model.E if e != "ID Buy" for t in model.T) +
            sum(model.P_c_t[c, t] * model.y_c_t[c, t] for c in model.C for t in model.T) -
            sum(model.P_e_t["ID Buy", t] * model.x_e_t["ID Buy", t] for t in model.T)
        )
        return immediate_value
    
    model.OBJ = pyo.Objective(rule=objective_function, sense=pyo.maximize)
    model.dual = pyo.Suffix(direction=pyo.Suffix.IMPORT)
    
    ### Constraints ###
    def start_reservoir_level_def_rule(model):
        return model.s_start_week == model.S_start
    model.Start_Reservoir_Level_Def = pyo.Constraint(rule=start_reservoir_level_def_rule)

    def initial_reservoir_balance_rule(model):
        t0 = min(model.T)
        return (
            model.s_t[t0]
            == model.s_start_week + model.I_t[t0] + model.ex_water_inflow - model.P_hyd[t0] / 1000
        )
    model.Initial_Reservoir_Balance = pyo.Constraint(rule=initial_reservoir_balance_rule)
    
    def end_reservoir_level_rule(model):
        return model.s_end == model.s_t[max(model.T)]
    model.End_Reservoir_Level_Def = pyo.Constraint(rule=end_reservoir_level_rule)
    
    if is_last_stage and S_end_target is not None:
        def end_reservoir_target_min_rule(model):
            return model.s_end == "# Value #"
        def end_reservoir_target_max_rule(model):
            return model.s_end == "# Value #"
        model.End_Reservoir_Target_Min = pyo.Constraint(rule=end_reservoir_target_min_rule)
        model.End_Reservoir_Target_Max = pyo.Constraint(rule=end_reservoir_target_max_rule)
    
    # Cuts from future periods (Benders cuts)
    model.cut_constraints = pyo.ConstraintList()
    # Use cuts only when not in the terminal stage.
    if cuts and not is_last_stage:
        model.theta.unfix()
        for cut in cuts:
            expr = cut['intercept'] + cut['slope_v'] * (model.s_end - cut['state_v'])
            model.cut_constraints.add(model.theta <= expr)
    
    # Turbine capacity constraints
    def turbine_capacity_rule_max(model, t):
        production = sum(model.x_e_t[e, t] for e in model.E if e != "ID Buy") - model.x_e_t["ID Buy", t]
        return production <= model.C_max
    model.Turbine_Capacity_Max = pyo.Constraint(model.T, rule=turbine_capacity_rule_max)
    
    # Reservoir storage constraints
    def reservoir_storage_rule_max(model, t):
        return model.s_t[t] <= model.S_max - model.delta_down
    model.Reservoir_Storage_Max = pyo.Constraint(model.T, rule=reservoir_storage_rule_max)
    
    def reservoir_storage_rule_min(model, t):
        return model.s_t[t] >= model.S_min + model.delta_up
    model.Reservoir_Storage_Min = pyo.Constraint(model.T, rule=reservoir_storage_rule_min)
    
    # PQ constraint (turbine and generator efficiency)
    turbin_list_MW, gen_out = get_turbine_generator_data()
    m_turb, b_gen = create_coeff(turbin_list_MW, gen_out)
    
    def pq_constraint_rule(model, t, i):
        production = sum(model.x_e_t[e, t] for e in model.E if e != "ID Buy") - model.x_e_t["ID Buy", t]
        return production <= m_turb[i] * (model.P_hyd[t] - turbin_list_MW[i]) + b_gen[i]
    model.pq_constraint = pyo.Constraint(model.T, range(len(m_turb)), rule=pq_constraint_rule)
    
    # Minimum production constraint
    def turbine_capacity_min_rule(model, t):
        production = sum(model.x_e_t[e, t] for e in model.E if e != "ID Buy") - model.x_e_t["ID Buy", t]
        return production >= model.C_min
    model.Turbine_Capacity_Min = pyo.Constraint(model.T, rule=turbine_capacity_min_rule)
    
    # Reservoir balance (no spill)
    def reservoir_balance_rule(model, t):
        if t == min(model.T):
            return pyo.Constraint.Skip
        return model.s_t[t] == model.s_t[t-1] + model.I_t[t] - model.P_hyd[t] / 1000
    model.Reservoir_Balance = pyo.Constraint(model.T, rule=reservoir_balance_rule)
    
    # Bidding constraints
    def bidding_constraint_down_rule(model, t):
        production = sum(model.x_e_t[e, t] for e in model.E if e != "ID Buy") - model.x_e_t["ID Buy", t]
        return sum(model.y_c_t[c, t] for c in model.C_d) <= production - model.C_min
    model.Bidding_Constraint_Down = pyo.Constraint(model.T, rule=bidding_constraint_down_rule)
    
    def bidding_constraint_up_rule(model, t):
        production = sum(model.x_e_t[e, t] for e in model.E if e != "ID Buy") - model.x_e_t["ID Buy", t]
        return sum(model.y_c_t[c, t] for c in model.C_u) <= model.C_max - production
    model.Bidding_Constraint_Up = pyo.Constraint(model.T, rule=bidding_constraint_up_rule)
    
    # Capacity market limits
    def capacity_market_limit_rule(model, c, t):
        return model.y_c_t[c, t] <= model.V_c_t_max[c, t]
    model.Capacity_Market_Limit = pyo.Constraint(model.C, model.T, rule=capacity_market_limit_rule)
    
    # Intraday market limits
    def intraday_market_limit_rule(model, e, t):
        if e == "DA":
            return pyo.Constraint.Skip
        return model.x_e_t[e, t] <= model.V_e_t_max[e, t] * model.A_e[e]
    model.Intraday_Market_Limit = pyo.Constraint(model.E, model.T, rule=intraday_market_limit_rule)
    
    return model


