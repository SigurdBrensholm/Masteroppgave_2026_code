def prepare_pyomo_data(year_data, capacity_scenario):
    """Convert year data to Pyomo-compatible dictionaries."""
    
    # Energy prices
    P_e_t = {}
    for i, t in enumerate(T):
        P_e_t[("DA", t)] = float(year_data['spot_prices'][i])
        P_e_t[("ID Sell", t)] = float(year_data['id_prices'][i])
        P_e_t[("ID Buy", t)] = float(year_data['id_prices'][i])
    
    # Capacity prices  
    P_c_t = {}
    for i, t in enumerate(T):
        P_c_t[("aFRR Up", t)] = float(year_data['afrr_up_prices'][i])
        P_c_t[("aFRR Down", t)] = float(year_data['afrr_down_prices'][i])
        P_c_t[("FCR-N", t)] = float(year_data['fcr_n_prices'][i])
        P_c_t[("FCR-D", t)] = float(year_data['fcr_d_prices'][i])
    

    # Volume constraints
    V_e_t_max = {}
    for i, t in enumerate(T):
        V_e_t_max[("ID Sell", t)] = float(year_data['id_sell_volumes'][i])
        V_e_t_max[("ID Buy", t)] = float(year_data['id_buy_volumes'][i])
    
    V_c_t_max = {}
    for c in C:
        for t in T:
            V_c_t_max[(c, t)] = float(capacity_scenario[c])
    
    return P_e_t, P_c_t, I_t, V_e_t_max, V_c_t_max


def forward_pass_simulation(year, K_stages, year_data, C_max, C_min, capacity_scenario):
    """Sequential forward pass simulation for one year with SDDP cuts."""
    
    # Prepare data
    P_e_t, P_c_t, I_t, V_e_t_max, V_c_t_max = prepare_pyomo_data(year_data, capacity_scenario)
    
    solver = SolverFactory('gurobi')
    solver.options['DualReductions'] = 0
    solver.options['Presolve'] = 0
    
    current_reservoir = S_0
    results = []
    
    print(f"\n=== Forward pass simulation: {year} ===")
    
    for stage_num in range(52):  # 52 weeks
        stage_hours = STAGES[stage_num]
        is_last = (stage_num == 51)
        
        # Stage data
        P_e_t_stage = {(e, t): P_e_t[(e, t)] for e in E for t in stage_hours}
        P_c_t_stage = {(c, t): P_c_t[(c, t)] for c in C for t in stage_hours}
        I_t_stage = {t: I_t[t] for t in stage_hours}
        V_c_t_max_stage = {(c, t): V_c_t_max[(c, t)] for c in C for t in stage_hours}
        V_e_t_max_stage = {(e, t): V_e_t_max[(e, t)] for e in ["ID Sell", "ID Buy"] for t in stage_hours}
        
        cuts = K_stages.get(stage_num, [])
        
        # Create stage model
        model = create_stage_model_simulation(
            stage_hours=stage_hours,
            E=E, C=C, C_d=C_d, C_u=C_u,
            P_e_t=P_e_t_stage,
            P_c_t=P_c_t_stage,
            I_t=I_t_stage,
            C_max=C_max, C_min=C_min,
            S_max=S_max, S_min=S_min,
            V_c_t_max=V_c_t_max_stage,
            V_e_t_max=V_e_t_max_stage, 
            S_start=current_reservoir,
            A_e=A_e,
            cuts=cuts,
            is_last_stage=is_last,
            S_end_target=S_0 if is_last else None,
            allow_end_slack=is_last,
        )
        
        # Solve
        result = solver.solve(model, tee=False)
        
        # Extract results
        end_reservoir = float(pyo.value(model.s_end))
        stage_obj = float(pyo.value(model.OBJ))
        theta_val = float(pyo.value(model.theta)) 
        stage_revenue = stage_obj - theta_val
        
        
        # Hourly details
        for t in stage_hours:
            # Production
            da_prod = float(pyo.value(model.x_e_t["DA", t]))
            id_sell = float(pyo.value(model.x_e_t["ID Sell", t])) 
            id_buy = float(pyo.value(model.x_e_t["ID Buy", t]))
            
            # Capacity 
            afrr_up = float(pyo.value(model.y_c_t["aFRR Up", t]))
            afrr_down = float(pyo.value(model.y_c_t["aFRR Down", t]))
            fcr_n = float(pyo.value(model.y_c_t["FCR-N", t]))
            fcr_d = float(pyo.value(model.y_c_t["FCR-D", t]))
            
            reservoir = float(pyo.value(model.s_t[t]))
            
            # Revenues
            rev_da = P_e_t_stage[("DA", t)] * da_prod
            rev_id = P_e_t_stage[("ID Sell", t)] * id_sell - P_e_t_stage[("ID Buy", t)] * id_buy
            rev_afrr_up = P_c_t_stage[("aFRR Up", t)] * afrr_up
            rev_afrr_down = P_c_t_stage[("aFRR Down", t)] * afrr_down
            rev_fcr_n = P_c_t_stage[("FCR-N", t)] * fcr_n
            rev_fcr_d = P_c_t_stage[("FCR-D", t)] * fcr_d
            
            
            p_hyd = float(pyo.value(model.P_hyd[t])) if hasattr(model, 'P_hyd') and t in model.P_hyd else None
            net_energy_sold = da_prod + id_sell - id_buy
            results.append({
                "Year": year,
                "Week": stage_num + 1,
                "Hour": t,
                "Reservoir_GWh": reservoir,
                "End_Reservoir_GWh": end_reservoir,
                "Water_Value_EUR_per_GWh": water_value,
                "DA_prod_MWh": da_prod,
                "ID_sell_MWh": id_sell,
                "ID_buy_MWh": id_buy,
                "aFRR_up_MW": afrr_up,
                "aFRR_down_MW": afrr_down, 
                "FCR_N_MW": fcr_n,
                "FCR_D_MW": fcr_d,
                "Spot_price": P_e_t_stage[("DA", t)],
                "Price_aFRR_up": P_c_t_stage[("aFRR Up", t)],
                "Price_aFRR_down": P_c_t_stage[("aFRR Down", t)],
                "Price_FCR_N": P_c_t_stage[("FCR-N", t)],
                "Price_FCR_D": P_c_t_stage[("FCR-D", t)],
                "Rev_DA_EUR": rev_da,
                "Rev_ID_EUR": rev_id,
                "Rev_aFRR_up_EUR": rev_afrr_up,
                "Rev_aFRR_down_EUR": rev_afrr_down,
                "Rev_FCR_N_EUR": rev_fcr_n,
                "Rev_FCR_D_EUR": rev_fcr_d,
                "Rev_total_EUR": rev_da + rev_id + rev_afrr_up + rev_afrr_down + rev_fcr_n + rev_fcr_d,
                "Inflow_GWh": I_t_stage[t],
                "Ex_Water_GWh": ex_water,
                "Theta_EUR": theta_val,
                "Stage_Revenue_EUR": stage_revenue,
                "P_hyd_MWh_per_h": p_hyd,
                "Net_energy_sold_MWh": net_energy_sold,
            })
        
        current_reservoir = end_reservoir
        
        if stage_num % 10 == 0:
            print(f"  Week {stage_num+1}/52, Revenue: {stage_revenue:.0f} EUR")
    
    total_revenue = sum(r["Rev_total_EUR"] for r in results)
    print(f"  Total {year} revenue: {total_revenue/1e6:.2f} MEUR")
    
    df = pd.DataFrame(results)

   
    return df


