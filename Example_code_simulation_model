def _make_capacity_config(nominal, with_reserve=True):
    
    if nominal == # Value # :
        c_max = _BASE_C_MAX
    else:
        c_max = nominal * 0.987
    
    if with_reserve:
        reserves = {c: (v / _BASE_C_MAX) * c_max for c, v in _BASE_RESERVES.items()}
    else:
        reserves = {"aFRR Up": 0, "aFRR Down": 0, "FCR-N": 0, "FCR-D": 0}
    
    return {"C_max": c_max, "C_min": 0.0, **reserves}

